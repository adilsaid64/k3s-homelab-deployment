# vars that connect to your proxmox server
export PROXMOX_VE_ENDPOINT=
export PROXMOX_VE_PASSWORD=
export PROXMOX_VE_USERNAME=
export PROXMOX_VE_INSECURE=

# iac creates an admin and viewer account, set passwords for those accounts and a ubuntu password for your vms
export SSH_PUBLIC_KEY=
# optional, defaults to ~/.ssh/id_ed25519
export SSH_PRIVATE_KEY_PATH=
export PROXMOX_ADMIN_PASSWORD=
export PROXMOX_VIEWER_PASSWORD=
export VM_SSH_PASSWORD_HASH=
export DEPLOY_GPU_WORKER=false
export GRAFANA_ADMIN_USER=admin
export GRAFANA_ADMIN_PASSWORD=

# Authentik IdP (app dashboards SSO). secret_key must be ≥50 chars.
# openssl rand -base64 48
export AUTHENTIK_SECRET_KEY=
# First-start only (empty DB). Token = Pulumi/API AUTHENTIK_TOKEN later.
# openssl rand -hex 32
export AUTHENTIK_BOOTSTRAP_TOKEN=
export AUTHENTIK_BOOTSTRAP_PASSWORD=
export AUTHENTIK_BOOTSTRAP_EMAIL=admin@k3s.local

# Standalone Postgres (Authentik + future apps)
export POSTGRES_PASSWORD=
