{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@pulumi/kubernetes": [".sst/platform/node_modules/@pulumi/kubernetes"],
      "@pulumi/command": [".sst/platform/node_modules/@pulumi/command"],
      "@pulumi/random": [".sst/platform/node_modules/@pulumi/random"],
      "@muhlba91/pulumi-proxmoxve": [".sst/platform/node_modules/@muhlba91/pulumi-proxmoxve"]
    }
  },
  "include": ["**/*.ts", ".sst/platform/config.d.ts"],
  "exclude": ["node_modules", ".sst/platform/node_modules"]
}
